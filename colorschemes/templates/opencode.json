{{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {{
    "background": "{background.base}",
    "backgroundBright": "{background.bright}",
    "foreground": "{foreground.base}",
    "foregroundDim": "{foreground.dim}",
    "accent": "{accent.base}",
    "info": "{info.base}",
    "success": "{success.base}",
    "successBackground": "{success.background}",
    "warning": "{warning.base}",
    "warningBackground": "{warning.background}",
    "error": "{error.base}",
    "errorBackground": "{error.background}",
    "red": "{red}",
    "green": "{green}",
    "blue": "{blue}",
    "yellow": "{yellow}",
    "cyan": "{cyan}",
    "magenta": "{magenta}",
    "orange": "{orange}"
  }},
  "theme": {{
    "primary": {{ "dark": "accent", "light": "accent" }},
    "secondary": {{ "dark": "info", "light": "info" }},
    "accent": {{ "dark": "accent", "light": "accent" }},
    "error": {{ "dark": "error", "light": "error" }},
    "warning": {{ "dark": "warning", "light": "warning" }},
    "success": {{ "dark": "success", "light": "success" }},
    "info": {{ "dark": "info", "light": "info" }},
    "text": {{ "dark": "foreground", "light": "foreground" }},
    "textMuted": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "background": {{ "dark": "background", "light": "background" }},
    "backgroundPanel": {{ "dark": "backgroundBright", "light": "backgroundBright" }},
    "backgroundElement": {{ "dark": "backgroundBright", "light": "backgroundBright" }},
    "border": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "borderActive": {{ "dark": "accent", "light": "accent" }},
    "borderSubtle": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "diffAdded": {{ "dark": "successBackground", "light": "successBackground" }},
    "diffRemoved": {{ "dark": "errorBackground", "light": "errorBackground" }},
    "diffContext": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "diffHunkHeader": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "diffHighlightAdded": {{ "dark": "successBackground", "light": "successBackground" }},
    "diffHighlightRemoved": {{ "dark": "errorBackground", "light": "errorBackground" }},
    "diffAddedBg": {{ "dark": "successBackground", "light": "successBackground" }},
    "diffRemovedBg": {{ "dark": "errorBackground", "light": "errorBackground" }},
    "diffContextBg": {{ "dark": "backgroundBright", "light": "backgroundBright" }},
    "diffLineNumber": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "diffAddedLineNumberBg": {{ "dark": "successBackground", "light": "successBackground" }},
    "diffRemovedLineNumberBg": {{ "dark": "errorBackground", "light": "errorBackground" }},
    "markdownText": {{ "dark": "foreground", "light": "foreground" }},
    "markdownHeading": {{ "dark": "red", "light": "red" }},
    "markdownLink": {{ "dark": "blue", "light": "blue" }},
    "markdownLinkText": {{ "dark": "cyan", "light": "cyan" }},
    "markdownCode": {{ "dark": "green", "light": "green" }},
    "markdownBlockQuote": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "markdownEmph": {{ "dark": "blue", "light": "blue" }},
    "markdownStrong": {{ "dark": "red", "light": "red" }},
    "markdownHorizontalRule": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "markdownListItem": {{ "dark": "orange", "light": "orange" }},
    "markdownListEnumeration": {{ "dark": "orange", "light": "orange" }},
    "markdownImage": {{ "dark": "cyan", "light": "cyan" }},
    "markdownImageText": {{ "dark": "cyan", "light": "cyan" }},
    "markdownCodeBlock": {{ "dark": "foreground", "light": "foreground" }},
    "syntaxComment": {{ "dark": "foregroundDim", "light": "foregroundDim" }},
    "syntaxKeyword": {{ "dark": "magenta", "light": "magenta" }},
    "syntaxFunction": {{ "dark": "blue", "light": "blue" }},
    "syntaxVariable": {{ "dark": "orange", "light": "orange" }},
    "syntaxString": {{ "dark": "green", "light": "green" }},
    "syntaxNumber": {{ "dark": "blue", "light": "blue" }},
    "syntaxType": {{ "dark": "yellow", "light": "yellow" }},
    "syntaxOperator": {{ "dark": "magenta", "light": "magenta" }},
    "syntaxPunctuation": {{ "dark": "foreground", "light": "foreground" }}
  }}
}}
