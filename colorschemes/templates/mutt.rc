color normal default default

color index_flags   {warning.base}           default
color index_date    {secondary.base}         default
color index_author  {primary.base}           default
color index_subject {foreground.base}   default
color indicator     {primary.base}           {background.bright}

color header {primary.base} default
color header {warning.base} default "^Subject"
color status {primary.base} {background.bright}

color sidebar_indicator {primary.background}    {primary.base}
color sidebar_highlight {primary.base}       default
color sidebar_divider   default         default
color sidebar_flagged   {warning.base}       default
color sidebar_new       {secondary.base}     default

color body {warning.base} default "(https?)://[^[:space:]]+"
